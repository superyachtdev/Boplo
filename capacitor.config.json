{
  "appId": "app.boplo.flight",
  "appName": "Boplo",
  "webDir": "native/www",
  "backgroundColor": "#EDF2FA",
  "server": {
    "url": "https://boplo.app/flight-app.html",
    "cleartext": false,
    "errorPath": "/error.html",
    "allowNavigation": [
      "boplo.app",
      "*.boplo.app",
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.gstatic.com",
      "js.stripe.com",
      "*.stripe.com",
      "*.stripe.network",
      "cdn.jsdelivr.net",
      "unpkg.com",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "*.amazonaws.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#EDF2FA",
    "appendUserAgent": "BoploFlightiOS"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 2000,
      "backgroundColor": "#EDF2FA",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT",
      "backgroundColor": "#EDF2FA"
    }
  }
}
